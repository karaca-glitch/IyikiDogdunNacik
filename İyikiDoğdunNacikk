<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mutlu Yıllar!</title>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #121212;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .bg-glow {
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(229, 57, 53, 0.2) 0%, rgba(0,0,0,0) 70%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1;
            pointer-events: none;
        }

        .stage {
            position: relative;
            width: 320px;
            height: 320px;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2;
        }

        .box-container {
            position: relative;
            width: 280px;
            height: 180px;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .envelope {
            position: absolute;
            width: 100%;
            height: 100%;
            background-color: #c62828;
            border-radius: 0 0 8px 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            cursor: pointer;
            z-index: 3;
            transition: opacity 0.4s ease;
        }

        .envelope::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 0;
            border-left: 140px solid transparent;
            border-right: 140px solid transparent;
            border-top: 100px solid #e53935;
            transform-origin: top;
            transition: transform 0.4s ease;
            z-index: 5;
        }

        .envelope::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 0;
            border-left: 140px solid #b71c1c;
            border-right: 140px solid #b71c1c;
            border-top: 90px solid transparent;
            border-bottom: 90px solid #b71c1c;
            border-radius: 0 0 8px 8px;
            z-index: 4;
        }

        .open-btn {
            position: absolute;
            width: 55px;
            height: 55px;
            background-color: #fff;
            color: #b71c1c;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);
            z-index: 6;
            top: 45px;
            left: 112.5px;
            transition: all 0.3s ease;
            cursor: pointer;
            user-select: none;
        }

        .heart-svg {
            position: absolute;
            width: 100%;
            height: 100%;
            fill: #e53935;
            z-index: 2;
            opacity: 0;
            transform: scale(0);
            transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            filter: drop-shadow(0 10px 25px rgba(229,57,53,0.6));
        }

        .letter-content {
            position: absolute;
            width: 80%;
            text-align: center;
            color: #ffffff;
            font-size: 20px;
            font-weight: bold;
            line-height: 1.5;
            opacity: 0;
            z-index: 10;
            transform: scale(0);
            transition: all 0.5s ease 0.3s;
            text-shadow: 0 2px 8px rgba(0,0,0,0.6);
            pointer-events: none;
        }

        /* --- AKTİF DURUMLAR --- */
        .box-container.open .envelope::before {
            transform: rotateX(180deg);
            opacity: 0;
        }
        .box-container.open .open-btn {
            opacity: 0;
            transform: scale(0);
            pointer-events: none;
        }

        .box-container.transforming .envelope {
            opacity: 0;
            pointer-events: none;
        }
        .box-container.transforming {
            width: 300px;
            height: 300px;
        }
        .box-container.transforming .heart-svg {
            opacity: 1;
            transform: scale(1);
        }
        .box-container.transforming .letter-content {
            opacity: 1;
            transform: scale(1);
        }

        @keyframes heartbeat {
            0% { transform: scale(1); }
            20% { transform: scale(1.05); }
            40% { transform: scale(1); }
            60% { transform: scale(1.05); }
            80% { transform: scale(1); }
            100% { transform: scale(1); }
        }
        .box-container.pulse {
            animation: heartbeat 1.4s infinite ease-in-out;
        }
    </style>
</head>
<body>

    <div class="bg-glow"></div>

    <div class="stage">
        <div class="box-container" id="boxContainer">
            <div class="envelope"></div>
            <div class="open-btn" id="openBtn">✉</div>
            
            <svg class="heart-svg" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            
            <div class="letter-content">
                Doğum Günün Kutlu Olsun Canimmm🤍
            </div>
        </div>
    </div>

    <script>
        const boxContainer = document.getElementById('boxContainer');
        const openBtn = document.getElementById('openBtn');

        // Gül Yaprakları Efekti Fonksiyonu (Renkler kırmızı ve tonları olarak ayarlandı)
        function ruzgardaGuller() {
            var duration = 5 * 1000; // 5 saniye boyunca yoğun yağacak
            var animationEnd = Date.now() + duration;
            var defaults = { startVelocity: 10, spread: 360, ticks: 100, zIndex: 0, colors: ['#b71c1c', '#e53935', '#ff1744', '#d32f2f'] };

            function randomInRange(min, max) {
              return Math.random() * (max - min) + min;
            }

            var interval = setInterval(function() {
              var timeLeft = animationEnd - Date.now();

              if (timeLeft <= 0) {
                return clearInterval(interval);
              }

              var particleCount = 3 * (timeLeft / duration);
              // Yukarıdan aşağıya süzülen yapraklar efekti
              confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.9), y: Math.random() - 0.2 } }));
            }, 150);
        }

        openBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            
            boxContainer.classList.add('open');

            // Butona basıldığı an ilk büyük gül patlamasını yap
            confetti({
                particleCount: 150,
                spread: 80,
                origin: { y: 0.6 },
                colors: ['#b71c1c', '#e53935', '#ff1744']
            });

            // Süzülen gül yaprakları yağmurunu başlat
            ruzgardaGuller();

            setTimeout(() => {
                boxContainer.classList.add('transforming');
            }, 350);

            setTimeout(() => {
                boxContainer.classList.add('pulse');
            }, 950);
        });
    </script>
</body>
</html>
